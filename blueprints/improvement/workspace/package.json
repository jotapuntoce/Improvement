{
  "name": "jotapuntoce",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@jotapuntoce/admin",
    "dev:improvement": "turbo run dev --filter=@jotapuntoce/improvement",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @jotapuntoce/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @jotapuntoce/db exec drizzle-kit migrate",
    "db:studio": "pnpm --filter @jotapuntoce/db exec drizzle-kit studio",
    "db:seed": "node --experimental-strip-types packages/db/src/seed.ts"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "~6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "@types/node": "^24"
  }
}
