# Ver blueprint.md §10 para el detalle completo de cada variable (dónde obtenerla, en qué paso se
# vuelve requerida). Este archivo se commitea con valores en blanco u obviamente falsos — nunca con
# credenciales reales. Copia esto a .env.local (apps) y .env.test (pruebas de integración) y llena
# los valores reales de tu proyecto Supabase de desarrollo.

# Supabase — Settings → API. Requerido desde el paso 4.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Settings → API. Server-only, nunca en un archivo "use client". Requerido desde el paso 5.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Settings → Database → Connection pooling (puerto 6543). Requerido desde el paso 3.
DATABASE_URL=

# Supabase — Settings → Database → Direct connection (puerto 5432). Solo migraciones y seed. Requerido desde el paso 3.
DATABASE_URL_DIRECT=

# console.anthropic.com/settings/keys. Requerido desde el paso 11.
ANTHROPIC_API_KEY=

# resend.com/api-keys. Requerido desde el paso 9.
RESEND_API_KEY=

# Generado localmente: openssl rand -hex 32 — pégalo también en el proyecto Vercel. Requerido desde el paso 9.
CRON_SECRET=

# Base para construir enlaces de invitación/reset. http://localhost:3200 en dev. Requerido desde el paso 4.
NEXT_PUBLIC_APP_URL=http://localhost:3200

# URL pública de apps/improvement, usada solo por apps/admin para enlazar a la app real desde el
# panel ("Ir a Improvement"). No es secreta. http://localhost:3200 en dev.
NEXT_PUBLIC_IMPROVEMENT_URL=http://localhost:3200
